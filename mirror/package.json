{
  "name": "mirrortproto.github.io",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Reproducible enhanced mirror of Telegram API, Bot API, MTProto and TL schema documentation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:compiled": "node --test .build/tools/html-sanitizer.test.js",
    "test": "npm run compile --silent && npm run test:compiled --silent",
    "format:check": "prettier --check \"client/**/*.ts\" \"tools/**/*.ts\" eleventy.config.ts tsconfig.json package.json \".github/**/*.{yml,yaml,json}\"",
    "backup": "npm run compile --silent && node .build/tools/crawl.js",
    "extract": "npm run compile --silent && node .build/tools/extract.js",
    "nav": "npm run compile --silent && node .build/tools/gennav.js",
    "indexes": "npm run compile --silent && node .build/tools/genrefindexes.js",
    "generate:compiled": "node .build/tools/extract.js && node .build/tools/gennav.js && node .build/tools/genrefindexes.js && node .build/tools/build-client.js",
    "generate": "npm run compile --silent && npm run generate:compiled --silent",
    "render": "eleventy --config=.build/eleventy.config.js && node .build/tools/normalize-times.js && pagefind --site docs && node .build/tools/canonicalize-pagefind.js",
    "clean:compiled": "node .build/tools/clean.js",
    "clean": "npm run compile --silent && npm run clean:compiled --silent",
    "build": "npm run compile --silent && npm run test:compiled --silent && npm run clean:compiled --silent && npm run generate:compiled --silent && npm run render --silent && node .build/tools/verify.js && node .build/tools/quality.js",
    "quality": "npm run compile --silent && node .build/tools/quality.js",
    "serve": "npm run build && eleventy --config=.build/eleventy.config.js --serve",
    "check": "npm run format:check && npm run typecheck && npm run build",
    "reproducible": "npm run format:check --silent && npm run typecheck --silent && npm run compile --silent && node .build/tools/reproducibility.js",
    "extlinks": "npm run compile --silent && node .build/tools/extlinks.js",
    "expand-extra": "npm run compile --silent && node .build/tools/expand-extra.js",
    "list-blog": "npm run compile --silent && node .build/tools/list-blog.js",
    "print-structure": "npm run compile --silent && node .build/tools/print_structure.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@types/html-minifier-terser": "7.0.2",
    "@types/node": "24.10.1",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.5",
    "cbor-x": "1.6.6",
    "esbuild": "0.27.0",
    "html-minifier-terser": "7.2.0",
    "lightningcss": "1.33.0",
    "markdown-it-anchor": "9.2.1",
    "pagefind": "1.5.2",
    "prettier": "3.9.0",
    "sanitize-html": "2.17.7",
    "turndown": "7.2.2",
    "typescript": "5.9.3"
  }
}
