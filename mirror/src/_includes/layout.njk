<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
  (function () {
    try {
      var t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  })();
</script>
<script>
  (function () {
    /* Media placeholders: flag .img-box as loaded/broken at the same moment an
       inline on* handler would have. load/error/loadeddata do not bubble, but a
       capture-phase listener on document still sees them, and this runs in <head>
       before any media exists — so cached media never flashes the placeholder.
       Kept out of the markup because Instant View drops nodes with inline JS. */
    function mark(t, cls) {
      var b = t && t.closest && t.closest('.img-box');
      if (b) b.classList.add(cls);
    }
    document.addEventListener('load', function (e) {
      if (e.target && e.target.tagName === 'IMG') mark(e.target, 'img-ok');
    }, true);
    document.addEventListener('loadeddata', function (e) {
      if (e.target && e.target.tagName === 'VIDEO') mark(e.target, 'img-ok');
    }, true);
    document.addEventListener('error', function (e) {
      var t = e.target;
      if (t && (t.tagName === 'IMG' || t.tagName === 'VIDEO')) mark(t, 'img-broken');
    }, true);
  })();
</script>
<title>{{ title }} — MTProto Mirror</title>
{% if description %}<meta name="description" content="{{ description | htmlattr }}">{% endif %}
<meta property="og:title" content="{{ title | htmlattr }}">
{% if description %}<meta property="og:description" content="{{ description | htmlattr }}">{% endif %}
<meta property="og:type" content="article">
<meta property="og:site_name" content="MTProto Mirror">
<meta property="og:url" content="https://mirrortproto.github.io{{ page.url | urlpath }}">
<meta property="og:image" content="https://mirrortproto.github.io/apple-touch-icon.png">
<meta name="twitter:card" content="summary">
{# Telegram Instant View: заставляем IV-бота применить готовый шаблон Medium #}
<meta property="al:android:app_name" content="Medium">
<meta property="article:published_time" content="{{ site.backup_date }}T00:00:00+00:00">
<meta name="author" content="Telegram">
{# если появится свой канал — раскомментировать и указать @username:
<meta name="telegram:channel" content="@YourChannel"> #}
<link rel="canonical" href="https://mirrortproto.github.io{{ page.url | urlpath }}">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/icon-64.png" type="image/png" sizes="64x64">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/css/style.css">
{% if crumbs and crumbs.length %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for c in crumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":"{{ c.title | htmlattr }}","item":"{% if c.url.startsWith('http') %}{{ c.url }}{% else %}https://mirrortproto.github.io{{ c.url }}{% endif %}"}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
</head>
<body{% if section and section != 'other' %} data-pagefind-filter="section:{% if section == 'ref' %}schema{% elif section == 'faq' %}other{% else %}{{ section }}{% endif %}"{% endif %}>
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">MTProto&nbsp;<span>Mirror</span></a>
    <nav class="top-nav" aria-label="Sections">
      <a href="/api/" {% if section == 'api' %}class="active" aria-current="section"{% endif %}>API</a>
      <a href="/mtproto/" {% if section == 'mtproto' %}class="active" aria-current="section"{% endif %}>MTProto</a>
      <a href="/schema/" {% if section == 'schema' or section == 'ref' %}class="active" aria-current="section"{% endif %}>Schema</a>
      <a href="/faq/" {% if section == 'faq' %}class="active" aria-current="section"{% endif %}>FAQ</a>
    </nav>
    <form class="site-search" action="/search/" method="get" role="search">
      <span class="search-field">
        <input type="search" name="q" placeholder="Search" aria-label="Search (press / to focus)">
        <kbd class="search-kbd" aria-hidden="true">/</kbd>
      </span>
    </form>
    <a class="search-button" href="/search/" aria-label="Search">
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.7"/><line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    </a>
    <a class="source-link" href="https://github.com/mirrortproto/mirrortproto.github.io" rel="noopener">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      <span class="source-link-text">Site Source Code</span>
    </a>
    <div class="theme-switch" role="group" aria-label="Color theme">
      <div class="theme-seg">
        <button type="button" data-mode="auto" aria-pressed="false" title="System theme">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><rect x="2" y="2.5" width="12" height="8.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M6.5 13.5h3M8 11v2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <button type="button" data-mode="light" aria-pressed="false" title="Light theme">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M12.6 3.4l-1.3 1.3M4.7 11.3l-1.3 1.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <button type="button" data-mode="dark" aria-pressed="false" title="Dark theme">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z" fill="currentColor"/></svg>
        </button>
      </div>
      <button class="theme-toggle" type="button" data-mode="auto" title="Color theme: auto">
        <svg class="icon-auto" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><rect x="2" y="2.5" width="12" height="8.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M6.5 13.5h3M8 11v2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <svg class="icon-light" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M12.6 3.4l-1.3 1.3M4.7 11.3l-1.3 1.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <svg class="icon-dark" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z" fill="currentColor"/></svg>
      </button>
    </div>
  </div>
</header>
<div class="layout">
  {% set showAll = section == 'other' %}
  {% set currentGroup = 'schema' if section == 'ref' else ('other' if section == 'faq' else section) %}
  {% if crumbs and crumbs.length %}
    <div class="crumbs">
      {% for c in crumbs %}<a href="{{ c.url }}">{{ c.title }}</a>{% if not loop.last %} <span class="crumb-sep">›</span> {% endif %}{% endfor %}
    </div>
  {% endif %}
  {# One navigation tree for both breakpoints. CSS places it in the sticky left
     column on desktop and as an accordion above the article on mobile; the two
     used to be separate DOM subtrees carrying identical links.
     .nav-pinned = the single-section case, which desktop keeps permanently
     expanded (and non-interactive) while mobile keeps it collapsed by default —
     a difference <details> cannot express in markup, so the script below syncs
     the `open` state to the breakpoint. #}
  <nav class="sidebar" aria-label="Pages in this section">
    {% for group in nav.sections %}
      {% if showAll or group.key == currentGroup %}
      <details class="nav-group{% if not showAll %} nav-pinned{% endif %}"{% if not showAll %} open{% endif %}>
        <summary class="nav-group-title">
          <svg class="chev" width="10" height="10" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{{ group.title }}</span>
        </summary>
        <ul>
          {% for item in group.items %}
            <li{% if page.url == item.url %} class="active"{% endif %}><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
    {% endfor %}
  </nav>
  {# Breakpoint sync for .nav-pinned. A <details> cannot carry two different
     default states, but desktop needs the single-section group expanded and
     mobile needs it collapsed. This runs while the nav is still being parsed —
     before first paint — so the mobile state never flashes open. It also drops
     the summary from the desktop tab order, matching the inert <div> title it
     replaced; without JS the group simply stays expanded, which stays usable.
     Emitted minified on purpose: it ships on every one of ~3200 pages. #}
  {% if not showAll %}<script>(function(){var p=document.querySelectorAll('.nav-pinned'),m=window.matchMedia&&matchMedia('(max-width:900px)');if(!p.length||!m)return;function s(){for(var i=0;i<p.length;i++){p[i].open=!m.matches;var t=p[i].firstElementChild;if(t&&t.tagName==='SUMMARY')t.tabIndex=m.matches?0:-1}}s();m.addEventListener?m.addEventListener('change',s):m.addListener&&m.addListener(s)})();</script>{% endif %}
  <main class="content" id="content">
    <article>
      {{ content | safe }}
      <div class="source-note">
        {# Pages the mirror builds itself (the schema indexes, search, 404, the
           home page) have no upstream counterpart, so `original` can only point
           at the nearest original page. Saying so keeps the note below from
           reading as "this is a copy of that URL". #}
        {% if generated %}<p class="generated-note">This page is generated by the mirror for convenience: the original documentation has no page like it.</p>{% endif %}
        {{ "Closest original" if generated else "Original" }}: <a href="{{ original }}" rel="noopener">{{ original }}</a>
      </div>
    </article>
  </main>
</div>
<footer class="site-footer">
  A mirror of <a href="https://core.telegram.org" rel="noopener">core.telegram.org</a> (Telegram API, MTProto, Schema).
  Content snapshot: {{ site.backup_date }}.
</footer>
<script>
  (function () {
    var btn = document.querySelector('.theme-toggle');
    var seg = Array.prototype.slice.call(document.querySelectorAll('.theme-seg button'));
    if (!btn && !seg.length) return;
    var order = ['auto', 'light', 'dark'];
    function current() { try { return localStorage.getItem('theme') || 'auto'; } catch (e) { return 'auto'; } }
    function set(mode) {
      try { mode === 'auto' ? localStorage.removeItem('theme') : localStorage.setItem('theme', mode); } catch (e) {}
      apply(mode);
    }
    function apply(mode) {
      if (mode === 'auto') document.documentElement.removeAttribute('data-theme');
      else document.documentElement.setAttribute('data-theme', mode);
      if (btn) {
        btn.dataset.mode = mode;
        btn.title = 'Color theme: ' + mode;
        btn.setAttribute('aria-label', 'Color theme: ' + mode + '. Click to switch.');
      }
      seg.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.mode === mode)); });
      var dark = mode === 'dark' || (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
        if ((m.media || '').indexOf('dark') !== -1) m.content = dark ? '#0d1117' : '#ffffff';
      });
    }
    seg.forEach(function (b) {
      b.addEventListener('click', function () { set(b.dataset.mode); });
    });
    if (btn) btn.addEventListener('click', function () {
      set(order[(order.indexOf(current()) + 1) % order.length]);
    });
    apply(current());
  })();
  (function () {
    document.addEventListener('keydown', function (e) {
      var tag = (document.activeElement && document.activeElement.tagName) || '';
      if (e.key === '/' && !/^(input|textarea|select)$/i.test(tag)) {
        var q = document.querySelector('.site-search input') || document.querySelector('.pagefind-ui__search-input');
        if (q) { e.preventDefault(); q.focus(); }
      }
    });
  })();
  (function () {
    /* Sweep for media that already settled before the head listener could see it
       (future load/error events are handled there). */
    document.querySelectorAll('.img-box').forEach(function (box) {
      var m = box.querySelector('img, video');
      if (!m) return;
      if (m.tagName === 'IMG') {
        if (m.complete) box.classList.add(m.naturalWidth > 0 ? 'img-ok' : 'img-broken');
      } else if (m.readyState >= 2) {
        box.classList.add('img-ok');
      }
    });
  })();
</script>
</body>
</html>
